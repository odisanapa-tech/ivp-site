# Публикация форм — Resend (см. lib/mail.ts). На старте можно оставить пустым, письма пойдут в лог.
RESEND_API_KEY=
CONTACT_EMAIL=hello@ivp.example

# Внешняя LMS: URL, куда ведёт кнопка «Личный кабинет». Заглушка до момента выбора платформы.
NEXT_PUBLIC_LMS_URL=https://lms.ivp.example

# Аналитика — заполнить после подключения счётчиков
NEXT_PUBLIC_YM_ID=
NEXT_PUBLIC_GA_ID=
